# ==================================================
# Halal Equity & IPO Research Platform
# Environment Configuration
# ==================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ==================================================

# ---- Application ----
APP_ENV=development
APP_PORT=8080
APP_SECRET_KEY=change-this-to-a-random-secret-key

# ---- PostgreSQL ----
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=halal_equity
POSTGRES_USER=halal_user
POSTGRES_PASSWORD=change-this-password
DATABASE_URL=postgres://halal_user:change-this-password@postgres:5432/halal_equity?sslmode=disable

# ---- Redis ----
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://redis:6379/0

# ---- JWT ----
JWT_SECRET=change-this-to-a-long-random-jwt-secret
JWT_EXPIRY_HOURS=24

# ---- Frontend ----
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost:8080/ws
FRONTEND_PORT=3000

# ---- Python Quant Engine ----
QUANT_ENGINE_URL=http://quant:8000
QUANT_ENGINE_PORT=8000

# ---- Market Data Providers ----
# Yahoo Finance (free, no key required)
YAHOO_FINANCE_ENABLED=true

# Angel One
ANGEL_ONE_API_KEY=
ANGEL_ONE_CLIENT_ID=
ANGEL_ONE_PASSWORD=
ANGEL_ONE_TOTP_SECRET=

# Groww (unofficial, use with caution)
GROWW_ENABLED=false

# ---- LLM Provider ----
# Options: gemini, ollama
LLM_PROVIDER=gemini
GEMINI_API_KEY=
OLLAMA_URL=http://localhost:11434

# ---- Telegram Notifications ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---- Email Notifications ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# ---- Logging ----
LOG_LEVEL=info
LOG_FORMAT=json

# ----# External Providers
YAHOO_FINANCE_RATE_LIMIT=2000
NSE_DATA_RATE_LIMIT=500

# Trading Execution Flags
PAPER_TRADING_ENABLED=true
LIVE_ORDER_EXECUTION=false
BROKER_TRADING_ENABLED=false

# ---- Rate Limiting ----
RATE_LIMIT_RPS=10
RATE_LIMIT_BURST=20
